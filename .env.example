# Copy to .env.local (dev) / .env.test (tests) and adjust when not using docker-compose.
# The defaults below match docker-compose.yml (Postgres 17 on localhost:5432).

# Application database (dev server, seed, migrate, ingest)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clipping_dev

# Test database. pnpm test creates and migrates it automatically.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/clipping_test

# Secret used to sign the demo session cookie (HMAC-SHA256). Pick a long random
# value for any shared deployment. Without a real auth provider this cookie is
# the whole session layer, so the secret must stay server-side only.
COOKIE_SECRET=dev-only-change-me-please-32-chars-min

# Local Postgres without Docker (scripts/db-local.sh, port 5433, trust auth):
#   DATABASE_URL=postgres://postgres@127.0.0.1:5433/clipping_dev
#   TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5433/clipping_test
